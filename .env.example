# Inbound BDR Agent - environment template (Req 14.3)
# Copy to `.env.local` and fill in real values. Never commit a filled-in copy.
# Only the SELECTED provider's key is required; the others may stay blank.

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------

# Which LLM adapter to use. One of: openai | anthropic | gemini | openrouter
LLM_PROVIDER=openrouter

# Bearer key for OpenAI. Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key

# Bearer key for Anthropic. Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# API key for Gemini. Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key

# Bearer key for the OpenRouter gateway. Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key

# Primary model slug used through OpenRouter. Optional; defaults to google/gemma-4-31b-it:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Secondary model slug, tried only on a stage's final attempt after the primary exhausts schema retries. Optional; defaults to google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# Sent to OpenRouter as the HTTP-Referer attribution header. Optional; carries no secret
OPENROUTER_APP_URL=https://your-deployment.example.com

# Sent to OpenRouter as the X-Title attribution header. Optional; carries no secret
OPENROUTER_APP_TITLE=Inbound BDR Agent

# Client-side ceiling on LLM requests per rolling minute, across all adapters. Optional; defaults to 20
LLM_MAX_RPM=20

# ---------------------------------------------------------------------------
# Search provider selection
# ---------------------------------------------------------------------------

# Which web search adapter to use. One of: tavily | exa | serper
SEARCH_PROVIDER=tavily

# API key for Tavily search. Required only when SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-key

# API key for Exa search. Required only when SEARCH_PROVIDER=exa
EXA_API_KEY=your-exa-key

# API key for Serper search. Required only when SEARCH_PROVIDER=serper
SERPER_API_KEY=your-serper-key

# ---------------------------------------------------------------------------
# Run store (both variables must be present to use Upstash Redis; otherwise the
# process falls back to a development-only JSON file store under .data/runs/)
# ---------------------------------------------------------------------------

# Upstash Redis REST endpoint for durable run persistence. Optional
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io

# Upstash Redis REST token paired with the URL above. Optional
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ---------------------------------------------------------------------------
# Inbound webhook + AE handoff delivery (both optional)
# ---------------------------------------------------------------------------

# Where the Stage 6 AE handoff summary is POSTed after a run finishes. Any endpoint
# that accepts a JSON body works; a Slack incoming-webhook URL renders the payload's
# `text` field directly. Optional; when unset, delivery is skipped and the run is
# unaffected (deliverHandoff reports delivered:false, channel:"none")
AE_HANDOFF_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/your-webhook

# Shared secret POST /api/inbound requires in the `x-webhook-secret` header.
# Optional; when unset the inbound endpoint is OPEN (demo mode) and accepts any caller
INBOUND_WEBHOOK_SECRET=your-inbound-webhook-secret

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------

# Maximum number of case-study pages crawled per run. Optional; defaults to 12
CRAWL_MAX_PAGES=12

# Per-request HTTP timeout in milliseconds for search and page fetches. Optional; defaults to 15000
REQUEST_TIMEOUT_MS=15000
